{% layout 'default' %}
{%- comment -%}
  Standalone pages. Hugo picked a Go template per section; Timber resolves templates by
  content *type*, so the page's own `layout` field selects the body:

    home      → anatole's index.html (recent posts with summaries)
    archive   → anatole's _default/list.html (posts grouped by year)
    portfolio → the site's custom layouts/portfolio/list.html
    plain     → body only
{%- endcomment -%}
{% block main %}
  {%- comment -%}
    The home page carries no body of its own (Hugo's content/_index.md was absent too),
    so capture the rendered body and skip the wrapper entirely when there is nothing to
    show — otherwise the listing sits under an empty card.
  {%- endcomment -%}
  {%- capture body %}{{ content }}{% endcapture -%}
  {%- unless page.layout == 'home' and body == blank -%}
    <div class="post animated fadeInDown">
      <div class="post__content">
        {% unless page.layout == 'home' %}<h1>{{ page.title }}</h1>{% endunless %}
        {{ content }}
      </div>
    </div>
  {%- endunless -%}

  {%- case page.layout -%}

  {%- when 'home' -%}
    {% for post in collections.posts %}
      <div class="post animated fadeInDown">
        {% if post.thumbnail %}
          <div class="post__thumbnail-wrapper">
            <a href="{{ post.url | relative_url }}">
              <img class="post__thumbnail" src="{{ post.url | relative_url }}{{ post.thumbnail }}" alt="{{ post.title }}" loading="lazy" />
            </a>
          </div>
        {% endif %}
        <div class="post__content">
          <h3><a href="{{ post.url | relative_url }}">{{ post.title | upcase }}</a></h3>
          {%- comment -%}
            anatole's index.html shows `.Summary` — the opening of the post itself, not
            the meta description — and offers "Read more" only when the post is actually
            `.Truncated`. `post.excerpt`/`post.truncated` are the generator's equivalents:
            the body up to `<!--more-->`, else its first paragraph. `description` remains
            the fallback for a post with no body to excerpt.
          {%- endcomment -%}
          {% if post.excerpt %}{{ post.excerpt }}{% else %}<p>{{ post.description }}</p>{% endif %}
          {% if post.truncated %}<a href="{{ post.url | relative_url }}">Read more</a>{% endif %}
        </div>
        <div class="post__footer">
          {%- render 'icons', name: 'calendar' -%}
          <span class="post__footer-date">{{ post.date | slice: 0, 10 | date: '%a, %b %-d, %Y', 0 }}</span>
        </div>
      </div>
    {% endfor %}

  {%- when 'archive' -%}
    {%- comment -%}
      Posts arrive newest-first (Timber sorts a collection by its first date field), so
      emitting a heading whenever the year changes reproduces Hugo's GroupByDate without
      a grouping filter.
    {%- endcomment -%}
    <div class="archive animated fadeInDown">
      {%- assign lastYear = '' -%}
      {% for post in collections.posts %}
        {%- assign year = post.date | slice: 0, 4 -%}
        {% if year != lastYear %}
          <div class="archive__heading">{{ year }}</div>
          {%- assign lastYear = year -%}
        {% endif %}
        <ul class="archive__list">
          <li class="archive__list-item">
            <a class="archive__list-title" href="{{ post.url | relative_url }}" title="{{ post.title }}">
              {{ post.title | upcase }}
            </a>
            <div class="archive__list-date">{{ post.date | slice: 0, 10 | date: '%b %-d', 0 }}</div>
          </li>
        </ul>
      {% endfor %}
    </div>

  {%- when 'portfolio' -%}
    <div class="portfolio-sort-controls">
      <label for="portfolio-sort">Sort by:</label>
      <select id="portfolio-sort" class="portfolio-sort-select">
        <option value="date-desc">Date (Newest First)</option>
        <option value="date-asc">Date (Oldest First)</option>
        <option value="category-date-desc">Category (Newest First)</option>
        <option value="category-date-asc">Category (Oldest First)</option>
      </select>
    </div>

    <div id="portfolio-container">
      {%- comment -%}
        The three categories are listed explicitly to preserve the order the Hugo data
        file used; `where` then pulls each one's projects out of the collection.
      {%- endcomment -%}
      {%- assign categories = 'Games,Other Software,Film & Television' | split: ',' -%}
      {% for category in categories %}
        {%- assign items = collections.projects | where: 'category', category | sort: 'start' | reverse -%}
        {% if items.size > 0 %}
          <div class="post animated fadeInDown" data-category="{{ category }}">
            <h2 class="portfolio__title" id="{{ category | remove: ' ' | remove: '&' | downcase }}">{{ category }}</h2>
            {% for project in items %}
              <div class="portfolio-item" data-date="{{ project.start }}" data-category="{{ category }}">
                <div class="portfolio-item__main">
                  {% if project.image %}
                    <div class="portfolio-item__image">
                      <a href="{{ project.url | relative_url }}">
                        <img src="{{ project.url | relative_url }}{{ project.image }}" alt="{{ project.title }}" loading="lazy" />
                      </a>
                    </div>
                  {% endif %}
                  <div class="portfolio-item__content">
                    <h2><a href="{{ project.url | relative_url }}">{{ project.title }}</a></h2>
                    <ul class="portfolio__meta">
                      {% if project.company %}
                        <li class="portfolio__meta-item">
                          {%- render 'icons', name: 'building' -%}<span>{{ project.company }}</span>
                        </li>
                      {% endif %}
                      {% if project.status %}
                        <li class="portfolio__meta-item">
                          {%- render 'icons', name: 'flag' -%}<span>{{ project.status }}</span>
                        </li>
                      {% endif %}
                      {% if project.start %}
                        <li class="portfolio__meta-item">
                          {%- render 'icons', name: 'calendar' -%}<span>{{ project.start }}</span>
                        </li>
                      {% endif %}
                    </ul>
                    <p>{{ project.description }}</p>
                    {% if project.link %}
                      <div class="portfolio__button-wrapper">
                        <a class="portfolio__button" href="{{ project.link }}" target="_blank" rel="noopener">
                          {{ project.linktext | default: 'Visit Site' }}
                        </a>
                      </div>
                    {% endif %}
                    {% if project.tags %}
                      <div class="separator">
                        {% for tag in project.tags %}<p class="tag">{{ tag }}</p>{% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <script src="{{ '/assets/js/portfolio-sort.js' | relative_url }}" defer></script>

  {%- endcase -%}
{% endblock %}
