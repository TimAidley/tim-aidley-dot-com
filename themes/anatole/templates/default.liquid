{%- comment -%}
  The site shell — anatole's `_default/baseof.html` + `partials/head.html` +
  `partials/sidebar.html` + `partials/navbar.html` + `partials/footer.html`, collapsed
  into one Liquid layout. Per-type templates `{% layout 'default' %}` and override the
  `main` block.

  The `theme--light` class on <html> is what `js/theme-switcher.js` swaps; it runs
  before <body> parses so a stored dark preference applies without a flash.
{%- endcomment -%}
<!doctype html>
<html lang="{{ page.lang | default: 'en' }}" dir="ltr" class="html theme--light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{{ seo.title }}</title>
    <meta name="author" content="{{ site.author }}" />
    <meta name="description" content="{{ seo.description }}" />
    <link rel="canonical" href="{{ seo.canonical }}" />
    <meta property="og:title" content="{{ seo.ogTitle }}" />
    <meta property="og:description" content="{{ seo.ogDescription }}" />
    <meta property="og:type" content="{{ seo.ogType }}" />
    {% if seo.ogImage %}<meta property="og:image" content="{{ seo.ogImage }}" />{% endif %}
    <meta name="twitter:card" content="summary" />
    <link rel="stylesheet" href="{{ '/assets/anatole.css' | relative_url }}" />
    <link rel="stylesheet" href="{{ '/assets/markupHighlight.css' | relative_url }}" />
    <script src="{{ '/assets/js/theme-switcher.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/nav.js' | relative_url }}"></script>
  </head>
  <body class="body">
    {%- assign footerYear = today | slice: 0, 4 -%}
    <div class="wrapper">
      <aside class="wrapper__sidebar">
        <div class="sidebar animated fadeInDown">
          <div class="sidebar__content">
            <div class="sidebar__introduction">
              {% if site.profilePicture %}
                <img
                  class="sidebar__introduction-profileimage"
                  src="{{ site.profilePicture | relative_url }}"
                  alt="{{ site.profilePicture.label | default: site.author }}"
                />
              {% endif %}
              <div class="sidebar__introduction-title">
                <a href="{{ '/' | relative_url }}">{{ site.title }}</a>
              </div>
              {% if site.description %}
                <div class="sidebar__introduction-description">
                  {%- comment -%}
                    Escape first, then turn newlines into breaks, so a multi-line bio keeps
                    its shape without letting raw markup through.
                  {%- endcomment -%}
                  <p>{{ site.description | escape | newline_to_br | raw }}</p>
                </div>
              {% endif %}
            </div>
            <ul class="sidebar__list">
              {%- assign socials = 'bluesky,mastodon,github,linkedin' | split: ',' -%}
              {%- for network in socials -%}
                {%- assign link = site[network] -%}
                {%- if link -%}
                  <li class="sidebar__list-item">
                    <a href="{{ link }}" target="_blank" rel="noopener me" title="{{ network }}" aria-label="{{ network }}">
                      {%- render 'icons', name: network -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
              {%- if site.email -%}
                <li class="sidebar__list-item">
                  <a href="mailto:{{ site.email }}" title="email" aria-label="email">
                    {%- render 'icons', name: 'email' -%}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
          {%- render 'footer', modifier: 'sidebar', year: footerYear, copyright: site.copyright, author: site.author -%}
        </div>
      </aside>
      <main class="wrapper__main">
        <header class="header">
          <div class="animated fadeInDown">
            <a role="button" class="navbar-burger" data-target="navMenu" aria-label="menu" aria-expanded="false">
              <span aria-hidden="true" class="navbar-burger__line"></span>
              <span aria-hidden="true" class="navbar-burger__line"></span>
              <span aria-hidden="true" class="navbar-burger__line"></span>
            </a>
            <nav class="nav">
              <ul class="nav__list" id="navMenu">
                {% for item in site.nav %}
                  <li class="nav__list-item">
                    <a href="{{ item.url | relative_url }}" title="{{ item.label }}">{{ item.label }}</a>
                  </li>
                {% endfor %}
              </ul>
              <ul class="nav__list nav__list--end">
                <li class="nav__list-item">
                  <div class="themeswitch">
                    <a title="Switch Theme">{%- render 'icons', name: 'theme' -%}</a>
                  </div>
                </li>
              </ul>
            </nav>
          </div>
        </header>
        {% block main %}
          <div class="post animated fadeInDown">
            <div class="post__content">
              <h1>{{ page.title | markdownify }}</h1>
              {{ content }}
            </div>
          </div>
        {% endblock %}
      </main>
    </div>
    {%- render 'footer', modifier: 'base', year: footerYear, copyright: site.copyright, author: site.author -%}
  </body>
</html>
